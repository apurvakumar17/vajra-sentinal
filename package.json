{
  "name": "sentinel-insider-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "(cd backend && python3 -m uvicorn main:app --host 127.0.0.1 --port 8001 --reload --reload-dir .) & (cd frontend && npx vite --host 0.0.0.0 --port 3000) & wait",
    "build": "cd frontend && npx vite build && cd .. && pip install --break-system-packages -r backend/requirements.txt",
    "start": "cd backend && python3 -m uvicorn main:app --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
